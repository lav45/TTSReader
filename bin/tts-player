#!/usr/bin/env bash
# Запуск плеера и подкоманда session из любого каталога и через символическую ссылку.
set -euo pipefail
root="$(dirname "$(dirname "$(readlink -f "$0")")")"
export PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}"
# Python с PyGObject, найденный install.sh; без файла — python3 из PATH.
python="$(cat "$root/.python" 2> /dev/null || true)"
python="${python:-python3}"
# session зовут на каждом хуке: лёгкий модуль без gi и плеера.
if [ "${1:-}" = session ]; then
    shift
    exec "$python" -m tts_player.session_command "$@"
fi
# sink зовёт демон claude-tts на каждое предложение (player_command): тоже без gi и плеера.
if [ "${1:-}" = sink ]; then
    shift
    exec "$python" -m tts_player.sink_command "$@"
fi
exec "$python" -m tts_player "$@"
