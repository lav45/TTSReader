#!/bin/bash
#
# tts-player-hook - хуки SessionStart и SessionEnd Claude Code: поднимает демон озвучки и
# плеер и регистрирует или снимает сессию в списке плеера.
#
# Демон claude-tts ищет проигрыватель по имени paplay через PATH; обёртка
# daemon-bin/paplay кладёт звук в буфер плеера, но работает, только если daemon-bin
# стоит первым в PATH демона.
#
# Вызов (JSON хука приходит на stdin; любые другие аргументы - usage, код 1, ничего не
# запускается и stdin не читается):
#   tts-player-hook start   - хук SessionStart: {"session_id": ..., "cwd": ..., ...}
#   tts-player-hook end     - хук SessionEnd:   {"session_id": ..., ...}
#
# start. Демона нет (нет живого PID в ~/.claude-tts/daemon.pid) -> claude-tts daemon start;
# демон жив, а первый элемент PATH в /proc/<pid>/environ не daemon-bin ->
# claude-tts daemon restart (до ~15 с, а у хука 5 с, поэтому отвязан через setsid,
# вывод в $XDG_RUNTIME_DIR/tts-player/daemon-restart.log);
# демон жив с daemon-bin первым -> не трогать.
# PID из файла принимается, только если в /proc/<pid>/cmdline есть claude-tts или
# claude_code_tts, иначе демона нет (старт, не перезапуск).
# Затем плеер: не запущен -> tts-player --tray отвязанным процессом (вывод в
# player.log); уже запущен (проба player.lock без записи) -> не трогать. Хук не ждёт плеер.
# Затем tts-player session add <session_id> <cwd>: сессия попадает в список плеера.
#
# end. Только tts-player session remove <session_id>: claude-tts не нужен, демон и плеер
# не запускаются.
#
# stdout хука пуст всегда: строки состояния (демон, плеер, вывод session add|remove,
# предупреждение о перезапуске демона) дописываются в $XDG_RUNTIME_DIR/tts-player/hook.log,
# ошибки идут в stderr.
#
# Код 0; 1 - stdin не JSON-объект, нет session_id (у start и cwd) непустой строкой, нет
# claude-tts (start) или tts-player в PATH, нет XDG_RUNTIME_DIR, неверные аргументы
# (сообщение в stderr), session add|remove вернул не 0.
# Только для тестов: TTS_HOOK_PROC (вместо /proc), TTS_HOOK_HOME (вместо $HOME).

set -u

fail() {
    echo "tts-player-hook: $1" >&2
    exit 1
}

# Аргументы проверяются до всего остального: неверный вызов ничего не запускает и
# не читает stdin.
if [ "$#" -ne 1 ] || { [ "$1" != "start" ] && [ "$1" != "end" ]; }; then
    fail "Usage: tts-player-hook start|end (JSON хука на stdin)"
fi
MODE="$1"

DAEMON_BIN="$(dirname "$(dirname "$(readlink -f "$0")")")/daemon-bin"
PROC="${TTS_HOOK_PROC:-/proc}"
HOME_DIR="${TTS_HOOK_HOME:-$HOME}"
PID_FILE="$HOME_DIR/.claude-tts/daemon.pid"

[ -z "${XDG_RUNTIME_DIR:-}" ] && fail "XDG_RUNTIME_DIR не задан"
STATE="$XDG_RUNTIME_DIR/tts-player"
LOCK="$STATE/player.lock"

LOG="$STATE/hook.log"

command -v tts-player > /dev/null || fail "tts-player не найден в PATH"

# Проба без записи: общая блокировка занята - плеер работает.
player_running() {
    [ -e "$LOCK" ] && ! flock -n -s "$LOCK" true 2> /dev/null
}

# Живой PID демона или пусто: PID из файла принимается, только если в
# /proc/<pid>/cmdline (разделитель NUL) есть claude-tts или claude_code_tts;
# иначе PID чужой (процесс прошлого демона умер, номер занят) - демона нет.
daemon_pid() {
    local pid
    [ -f "$PID_FILE" ] || return 0
    pid="$(< "$PID_FILE")"
    [[ "$pid" =~ ^[0-9]+$ ]] || return 0
    [ -d "$PROC/$pid" ] || return 0
    case "$(tr '\0' ' ' < "$PROC/$pid/cmdline" 2> /dev/null)" in
        *claude-tts* | *claude_code_tts*) echo "$pid" ;;
    esac
    return 0
}

# Первый элемент PATH демона.
daemon_first_path() {
    local entry
    while IFS= read -r -d '' entry; do
        case "$entry" in
            PATH=*)
                entry="${entry#PATH=}"
                echo "${entry%%:*}"
                return 0
                ;;
        esac
    done < "$PROC/$1/environ" 2> /dev/null
}

log() {
    echo "$*" >> "$LOG"
}

# Поле строкой из JSON-объекта на stdin или пусто.
json_field() {
    jq -r --arg key "$1" '(.[$key] // empty) | select(type == "string")' <<< "$INPUT"
}

start() {
    # $1 - session_id, $2 - cwd
    command -v claude-tts > /dev/null || fail "claude-tts не найден в PATH"

    local pid first restarted=0
    pid="$(daemon_pid)"
    if [ -z "$pid" ]; then
        PATH="$DAEMON_BIN:$PATH" claude-tts daemon start < /dev/null > /dev/null 2>&1
        if [ -n "$(daemon_pid)" ]; then
            log "демон запущен"
        else
            log "демон не запустился, см. ~/.claude-tts/daemon.log"
        fi
    else
        first="$(daemon_first_path "$pid")"
        if [ "$first" = "$DAEMON_BIN" ]; then
            log "демон уже с обёрткой"
        else
            PATH="$DAEMON_BIN:$PATH" setsid claude-tts daemon restart \
                < /dev/null >> "$STATE/daemon-restart.log" 2>&1 &
            restarted=1
            log "перезапуск демона с обёрткой запущен"
        fi
    fi

    if player_running; then
        log "плеер уже запущен"
    else
        setsid tts-player --tray < /dev/null >> "$STATE/player.log" 2>&1 &
        log "запуск плеера отдан (ошибки - $STATE/player.log)"
    fi
    if [ "$restarted" = 1 ]; then
        log "первый ответ после перезапуска демона может прозвучать мимо плеера"
    fi
    tts-player session add "$1" "$2" < /dev/null >> "$LOG" 2>&1 || fail "session add не записал запрос, см. $LOG"
}

end() {
    # $1 - session_id
    tts-player session remove "$1" < /dev/null >> "$LOG" 2>&1 || fail "session remove не выполнен, см. $LOG"
}

mkdir -p "$STATE" || fail "не удалось создать $STATE"
command -v jq > /dev/null || fail "jq не найден в PATH"

INPUT="$(cat)"
jq -e 'type == "object"' <<< "$INPUT" > /dev/null 2>&1 || fail "stdin не JSON-объект"
SESSION_ID="$(json_field session_id)"
[ -n "$SESSION_ID" ] || fail "в JSON нет session_id"

if [ "$MODE" = "start" ]; then
    CWD="$(json_field cwd)"
    [ -n "$CWD" ] || fail "в JSON нет cwd"
    start "$SESSION_ID" "$CWD"
else
    end "$SESSION_ID"
fi
