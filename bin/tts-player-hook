#!/bin/bash
#
# tts-player-hook - поднимает демон озвучки и плеер и регистрирует сессию Claude Code.
#
# Демон claude-tts ищет проигрыватель по имени paplay через PATH; обёртка
# daemon-bin/paplay кладёт звук в буфер плеера, но работает, только если daemon-bin
# стоит первым в PATH демона. Зовёт tts-toggle.sh на /tts-on.
#
# Вызов: tts-player-hook on <uuid> <cwd>; любые другие аргументы - usage, код 1,
# ничего не запускается.
#
# Демона нет (нет живого PID в ~/.claude-tts/daemon.pid) -> claude-tts daemon start;
# демон жив, а первый элемент PATH в /proc/<pid>/environ не daemon-bin ->
# claude-tts daemon restart (до ~15 с, а у хука 5 с, поэтому отвязан через setsid,
# вывод в $XDG_RUNTIME_DIR/tts-player/daemon-restart.log);
# демон жив с daemon-bin первым -> не трогать.
# PID из файла принимается, только если в /proc/<pid>/cmdline есть claude-tts или
# claude_code_tts, иначе демона нет (старт, не перезапуск).
# Затем плеер: не запущен -> tts-player --tray отвязанным процессом (вывод в
# player.log); уже запущен (проба player.lock без записи) -> не трогать. Хук не ждёт плеер.
# Затем tts-player session add <uuid> <cwd>: сессия попадает в список плеера, вывод
# команды идёт в stdout хука, а её код выхода становится кодом хука (1 - запрос не записан).
#
# Код 0; 1 - нет claude-tts или tts-player в PATH, нет XDG_RUNTIME_DIR, неверные или пустые
# аргументы (сообщение в stderr), session add не записал запрос.
# Только для тестов: TTS_HOOK_PROC (вместо /proc), TTS_HOOK_HOME (вместо $HOME).

set -u

fail() {
    echo "tts-player-hook: $1" >&2
    exit 1
}

# Аргументы проверяются до всего остального: неверный вызов ничего не запускает.
if [ "$#" -ne 3 ] || [ "$1" != "on" ] || [ -z "$2" ] || [ -z "$3" ]; then
    fail "Usage: tts-player-hook on <uuid> <cwd>"
fi
shift

DAEMON_BIN="$(dirname "$(dirname "$(readlink -f "$0")")")/daemon-bin"
PROC="${TTS_HOOK_PROC:-/proc}"
HOME_DIR="${TTS_HOOK_HOME:-$HOME}"
PID_FILE="$HOME_DIR/.claude-tts/daemon.pid"

[ -z "${XDG_RUNTIME_DIR:-}" ] && fail "XDG_RUNTIME_DIR не задан"
STATE="$XDG_RUNTIME_DIR/tts-player"
LOCK="$STATE/player.lock"

command -v tts-player > /dev/null || fail "tts-player не найден в PATH"

# Проба без записи: общая блокировка занята - плеер работает.
player_running() {
    [ -e "$LOCK" ] && ! flock -n -s "$LOCK" true 2> /dev/null
}

# Живой PID демона или пусто: PID из файла принимается, только если в
# /proc/<pid>/cmdline (разделитель NUL) есть claude-tts или claude_code_tts;
# иначе PID чужой (процесс прошлого демона умер, номер занят) - демона нет.
daemon_pid() {
    local pid
    [ -f "$PID_FILE" ] || return 0
    pid="$(< "$PID_FILE")"
    [[ "$pid" =~ ^[0-9]+$ ]] || return 0
    [ -d "$PROC/$pid" ] || return 0
    case "$(tr '\0' ' ' < "$PROC/$pid/cmdline" 2> /dev/null)" in
        *claude-tts* | *claude_code_tts*) echo "$pid" ;;
    esac
    return 0
}

# Первый элемент PATH демона.
daemon_first_path() {
    local entry
    while IFS= read -r -d '' entry; do
        case "$entry" in
            PATH=*)
                entry="${entry#PATH=}"
                echo "${entry%%:*}"
                return 0
                ;;
        esac
    done < "$PROC/$1/environ" 2> /dev/null
}

on() {
    # $1 - uuid сессии, $2 - cwd
    command -v claude-tts > /dev/null || fail "claude-tts не найден в PATH"
    mkdir -p "$STATE" || fail "не удалось создать $STATE"

    local pid first restarted=0
    pid="$(daemon_pid)"
    if [ -z "$pid" ]; then
        PATH="$DAEMON_BIN:$PATH" claude-tts daemon start < /dev/null > /dev/null 2>&1
        if [ -n "$(daemon_pid)" ]; then
            echo "демон запущен"
        else
            echo "демон не запустился, см. ~/.claude-tts/daemon.log"
        fi
    else
        first="$(daemon_first_path "$pid")"
        if [ "$first" = "$DAEMON_BIN" ]; then
            echo "демон уже с обёрткой"
        else
            PATH="$DAEMON_BIN:$PATH" setsid claude-tts daemon restart \
                < /dev/null >> "$STATE/daemon-restart.log" 2>&1 &
            restarted=1
            echo "перезапуск демона с обёрткой запущен"
        fi
    fi

    if player_running; then
        echo "плеер уже запущен"
    else
        setsid tts-player --tray < /dev/null >> "$STATE/player.log" 2>&1 &
        echo "запуск плеера отдан (ошибки - $STATE/player.log)"
    fi
    if [ "$restarted" = 1 ]; then
        echo "первый ответ после перезапуска может прозвучать мимо плеера - повторите /tts-on через несколько секунд"
    fi
    tts-player session add "$1" "$2" < /dev/null
}

on "$1" "$2"
