#!/usr/bin/env bash
# Хуки Claude Code: tts-player-hook start|end|stop|post-tool-use|pre-tool-use|prompt, JSON хука — на stdin.
# Устройство — в tts_player/hook_command.py. Каталог репозитория попадает в sys.path только
# этого процесса, не в PYTHONPATH: claude-tts, которого зовёт хук, его не наследует.
set -euo pipefail
root="$(dirname "$(dirname "$(readlink -f "$0")")")"
# Python, найденный install.sh; без файла — python3 из PATH (хуку хватает стандартной библиотеки).
python="$(cat "$root/.python" 2> /dev/null || true)"
exec "${python:-python3}" -c 'import sys; sys.path.insert(0, sys.argv.pop(1))
from tts_player.hook_command import main
sys.exit(main(sys.argv[1:]))' "$root" "$@"
