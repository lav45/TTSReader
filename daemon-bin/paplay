#!/bin/bash
#
# paplay - обёртка вместо настоящего paplay: не играет, а кладёт фразу в буфер плеера.
#
# Демон claude-tts ищет проигрыватель по имени paplay через PATH. daemon-bin стоит
# в начале PATH демона, поэтому он находит эту обёртку, а не системный paplay.
# Звук играет десктопное приложение-плеер: оно забирает файлы из буфера.
#
# Буфер: $XDG_RUNTIME_DIR/tts-player/inbox/, создаётся при необходимости.
# Файл:  {recv_ns}_{имя WAV}, recv_ns = date +%s%N, поэтому порядок имён по строке
#        совпадает с порядком вызовов.
# Запись атомарная: сначала cp в .{имя}.part, затем mv, плеер .part не видит.
#
# Вызов: paplay [опции] <wav>. Опции игнорируются, <wav> - последний аргумент.
# Объявления демона (tts_announce.wav, tts_daemon_announce.wav) пропускаются.
# Код 1: нет аргумента, нет XDG_RUNTIME_DIR, буфер не создан, копия не удалась;
# в буфере не остаётся ни файла, ни .part. Демон запускает плеер с stdout/stderr=DEVNULL
# и код не читает, поэтому сообщение о сбое идёт и в stderr, и в journal:
# logger -t tts-player-paplay (journalctl -t tts-player-paplay).

fail() {
    echo "paplay: $1" >&2
    logger -t tts-player-paplay "$1"
    exit 1
}

[ $# -eq 0 ] && fail "не указан WAV-файл"

WAV="${!#}"
NAME="$(basename "$WAV")"

case "$NAME" in
    tts_announce.wav | tts_daemon_announce.wav) exit 0 ;;
esac

[ -z "$XDG_RUNTIME_DIR" ] && fail "XDG_RUNTIME_DIR не задан"

INBOX="$XDG_RUNTIME_DIR/tts-player/inbox"
mkdir -p "$INBOX" || fail "не удалось создать буфер $INBOX"

FILE="$(date +%s%N)_$NAME"
PART="$INBOX/.$FILE.part"
trap 'rm -f "$PART"' EXIT

cp "$WAV" "$PART" || fail "не удалось скопировать $WAV"
mv "$PART" "$INBOX/$FILE" || fail "не удалось положить $FILE в буфер"
